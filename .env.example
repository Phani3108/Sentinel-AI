# ============================================================
# Sentinel AI — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_TIMEOUT=120

# --- Vision Model Selection ---
# Options: llava, florence2, moondream, phi3v, internvl
DEFAULT_VISION_MODEL=llava

# --- LLM Settings ---
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_CONTEXT_WINDOW=4096

# --- RAG / Vector DB ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=sentinel_docs
EMBEDDING_MODEL=nomic-embed-text     # or sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5

# --- API ---
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=1
LOG_LEVEL=INFO

# --- Hardware ---
# Options: cpu, cuda, mps (Apple Metal)
DEVICE=cpu
# For GPU: set to cuda:0 or mps
# DEVICE=mps

# --- Monitoring ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=sentinel-ai
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090

# --- MLflow (Fine-tuning) ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=sentinel-finetune

# --- Cloud Fallback (Hybrid Router - Phase 6) ---
# Set these only if using hybrid routing
# OPENAI_API_KEY=sk-...
# AZURE_OPENAI_ENDPOINT=https://...
# AZURE_OPENAI_KEY=...

# --- Paths ---
DATA_DIR=./data
MODELS_DIR=./models
BENCHMARK_OUTPUT_DIR=./benchmark/reports
