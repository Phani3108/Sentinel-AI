{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Sentinel AI — Inference Performance Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "fillOpacity": 20, "lineWidth": 2 },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.50, sum by(le, model) (rate(sentinel_vision_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 – {{model}}"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.95, sum by(le, model) (rate(sentinel_vision_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 – {{model}}"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.99, sum by(le, model) (rate(sentinel_vision_latency_seconds_bucket[5m])))",
          "legendFormat": "p99 – {{model}}"
        }
      ],
      "title": "Vision Model Latency (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.50, sum by(le, model) (rate(sentinel_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 – {{model}}"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.95, sum by(le, model) (rate(sentinel_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 – {{model}}"
        }
      ],
      "title": "LLM Generation Latency (p50 / p95)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(sentinel_requests_total[5m]))",
          "legendFormat": "req/sec"
        }
      ],
      "title": "Request Throughput",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(sentinel_errors_total[5m])) / sum(rate(sentinel_requests_total[5m]))",
          "legendFormat": "Error Rate"
        }
      ],
      "title": "Error Rate",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "mbytes"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sentinel_memory_usage_mb{component='process'}",
          "legendFormat": "Memory (MB)"
        }
      ],
      "title": "Process Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 6,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.95, sum by(le, vision_model, llm_model) (rate(sentinel_pipeline_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 – {{vision_model}} + {{llm_model}}"
        }
      ],
      "title": "End-to-End Pipeline Latency p95 by Model Pair",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 7,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(sentinel_llm_tokens_total[5m])) by (model)",
          "legendFormat": "tokens/sec – {{model}}"
        }
      ],
      "title": "LLM Token Throughput",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 22 },
      "id": 8,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sentinel_rag_documents_total",
          "legendFormat": "Docs in {{collection}}"
        }
      ],
      "title": "RAG Documents in Vector Store",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 22 },
      "id": 9,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.95, sum by(le, collection) (rate(sentinel_rag_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 RAG – {{collection}}"
        }
      ],
      "title": "RAG Retrieval Latency p95",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["sentinel-ai", "ai", "inference", "monitoring"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(sentinel_requests_total, vision_model)",
        "label": "Vision Model",
        "name": "vision_model",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Sentinel AI — Inference Dashboard",
  "uid": "sentinel-ai-inference",
  "version": 1
}
